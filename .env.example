DB_USER="seu-usuario"           # usuario do banco de dados
DB_PASSWORD="sua-senha"         # senha do banco de dados
DB_NAME="nome-banco-de-dados"   # nome do banco de dados
DB_PORT=5432                    # porta padrao do PostgreSQL
DB_HOST=db                      # nome do servico no compose; use localhost fora dele
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Seguranca — gere cada valor com:  openssl rand -base64 32
#
# O processo NAO SOBE sem as tres variaveis abaixo. Cada uma precisa ter
# no minimo 32 bytes, nao pode ser um valor conhecido/fraco (changeme,
# secret, admin, test, password, ou os fallbacks antigos do codigo), e as
# tres precisam ser DIFERENTES entre si — reusar a mesma chave em dois
# propositos significa que vazar uma vaza as duas. Ver ADR 0007.
JWT_SECRET="gere-um-valor-forte"
# Assina os tokens de login dos tenants (empresas). Trocar derruba todas as
# sessoes ativas (todo mundo faz login de novo). Recuperavel.

DEV_JWT_SECRET="gere-um-valor-forte-diferente"
# Assina os tokens do painel administrativo interno (visao de plataforma
# sobre todos os tenants). Separada do JWT_SECRET de proposito: se a chave
# de um tenant vazar, isso nao deve abrir o painel da plataforma inteira.
# Trocar derruba a sessao de quem estiver logado no painel. Recuperavel.

SETTINGS_ENC_KEY="gere-um-valor-forte-diferente-tambem"
# Cifra a senha de SMTP e o token do gateway de pagamento de cada tenant.
# ATENCAO: trocar torna esses dados PERMANENTEMENTE indecifraveis.
# Defina uma vez e nunca mais altere depois que o sistema estiver em uso.
